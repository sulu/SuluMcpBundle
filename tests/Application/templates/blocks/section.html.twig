<section class="my-12 border-t border-gray-200 pt-8">
    {% if block.title is defined and block.title %}
        <h2 class="text-2xl font-bold text-gray-900 mb-6">{{ block.title }}</h2>
    {% endif %}

    {% if block.blocks is defined %}
        {% for nested in block.blocks %}
            {{ include('blocks/' ~ nested.type ~ '.html.twig', {block: nested}) }}
        {% endfor %}
    {% endif %}
</section>
