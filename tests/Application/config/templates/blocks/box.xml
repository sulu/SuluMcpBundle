<?xml version="1.0" ?>
<template xmlns="http://schemas.sulu.io/template/template"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">

    <key>box</key>

    <meta>
        <title lang="en">Box</title>
        <title lang="de">Box</title>
    </meta>

    <properties>
        <property name="note" type="text_line">
            <meta>
                <title lang="en">Note</title>
                <title lang="de">Notiz</title>
            </meta>
        </property>

        <section name="box_content">
            <meta>
                <title lang="en">Box Content</title>
                <title lang="de">Boxinhalt</title>
            </meta>

            <properties>
                <property name="boxTitle" type="text_line" mandatory="true">
                    <meta>
                        <title lang="en">Box Title</title>
                        <title lang="de">Boxtitel</title>
                    </meta>
                </property>
            </properties>
        </section>
    </properties>
</template>
