<?xml version="1.0" ?>
<template xmlns="http://schemas.sulu.io/template/template"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">

    <key>section</key>

    <meta>
        <title lang="en">Section</title>
        <title lang="de">Abschnitt</title>
    </meta>

    <properties>
        <property name="title" type="text_line">
            <meta>
                <title lang="en">Section Title</title>
                <title lang="de">Abschnittstitel</title>
            </meta>
        </property>

        <block name="blocks" default-type="text" minOccurs="0">
            <meta>
                <title lang="en">Section Blocks</title>
                <title lang="de">Abschnittsblöcke</title>
            </meta>
            <types>
                <type ref="text"/>
                <type ref="heading"/>
                <type ref="quote"/>
                <type ref="box"/>
            </types>
        </block>

        <block name="stages" default-type="stage" minOccurs="0">
            <meta>
                <title lang="en">Stages</title>
                <title lang="de">Stufen</title>
            </meta>
            <types>
                <type name="stage">
                    <meta>
                        <title lang="en">Stage</title>
                        <title lang="de">Stufe</title>
                    </meta>
                    <properties>
                        <property name="label" type="text_line">
                            <meta>
                                <title lang="en">Label</title>
                                <title lang="de">Bezeichnung</title>
                            </meta>
                        </property>
                    </properties>
                </type>
            </types>
        </block>
    </properties>
</template>
