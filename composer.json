{
    "name": "sulu/mcp-bundle",
    "description": "Exposes Sulu content management as MCP tools for AI assistants",
    "keywords": [
        "symfony",
        "sulu",
        "sulucms",
        "cms",
        "mcp",
        "model-context-protocol",
        "ai"
    ],
    "homepage": "https://sulu.io/",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Sulu Community",
            "homepage": "https://github.com/sulu/SuluMcpBundle/graphs/contributors"
        }
    ],
    "support": {
        "issues": "https://github.com/sulu/SuluMcpBundle/issues",
        "source": "https://github.com/sulu/SuluMcpBundle",
        "docs": "https://docs.sulu.io/"
    },
    "require": {
        "php": "^8.2",
        "symfony/doctrine-bridge": "^7.3",
        "symfony/framework-bundle": "^7.3",
        "symfony/mcp-bundle": "^0.6",
        "sulu/sulu": "^3.0.8",
        "league/oauth2-server-bundle": "^1.1",
        "nyholm/psr7": "^1.4",
        "symfony/psr-http-message-bridge": "^7.3"
    },
    "require-dev": {
        "php-cs-fixer/shim": "^3.15",
        "phpstan/extension-installer": "^1.2",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^10.3",
        "rector/rector": "^2.1",
        "symfony/ai-mate": "^0.8.0",
        "symfony/ai-symfony-mate-extension": "^0.8.0",
        "symfony/ai-monolog-mate-extension": "^0.8.0",
        "matesofmate/composer-extension": "^0.3.0",
        "matesofmate/phpunit-extension": "^0.3.0",
        "matesofmate/phpstan-extension": "^0.3.0",
        "cmsig/seal-memory-adapter": "^0.12.2"
    },
    "autoload": {
        "psr-4": {
            "Sulu\\Bundle\\McpBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sulu\\Bundle\\McpBundle\\Tests\\": "tests/",
            "App\\Mate\\": "mate/src/"
        }
    },
    "extra": {
        "ai-mate": {
            "extension": false,
            "scan-dirs": [
                "mate/src"
            ],
            "includes": [
                "mate/config.php"
            ]
        }
    },
    "scripts": {
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "vendor/bin/phpunit"
        ],
        "test-with-coverage": "@test --coverage-php var/reports/coverage.cov --coverage-cobertura=var/cobertura-coverage.xml --coverage-html var/reports/html --log-junit var/reports/junit.xml",
        "phpstan": "@php vendor/bin/phpstan analyze",
        "lint-rector": "@php vendor/bin/rector process --dry-run",
        "lint-php-cs": "@php vendor/bin/php-cs-fixer fix --verbose --diff --dry-run",
        "lint": [
            "@phpstan",
            "@lint-php-cs",
            "@lint-rector",
            "@lint-composer"
        ],
        "lint-composer": "@composer validate",
        "rector": "@php vendor/bin/rector process",
        "php-cs-fix": "@php vendor/bin/php-cs-fixer fix",
        "fix": [
            "@rector",
            "@php-cs-fix"
        ]
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "symfony/ai-mate-composer-plugin": true
        }
    },
    "conflict": {
        "symfony/doctrine-bridge": "<6.4.2"
    }
}
